<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2D2B5E" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#6C63FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F2B47" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#6C63FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1A2E" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#2A3555" />
        </shape>
    </item>
</selector>
