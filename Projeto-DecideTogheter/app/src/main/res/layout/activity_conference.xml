<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela 4: Videoconferência + Sistema de Votação
    
    Estrutura de camadas (FrameLayout):
    1. Container do Jitsi Meet (ocupa toda a tela)
    2. Overlay de controles flutuantes (botões Nova Votação / Encerrar)
    3. Painel lateral de votação (aparece/desaparece via animação)
    4. Painel de histórico de decisões
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ===================================================================
         CAMADA 1: Container da videoconferência Jitsi Meet
         O JitsiMeetView ou Fragment do Jitsi é adicionado aqui via código
         =================================================================== -->
    <FrameLayout
        android:id="@+id/jitsiContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ===================================================================
         CAMADA 2: Barra de controles flutuantes (sempre visível)
         Posicionada na parte inferior da tela sobre o vídeo
         =================================================================== -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:paddingBottom="24dp"
        android:background="#99000000">

        <!-- Botão: Nova Votação -->
        <Button
            android:id="@+id/btnNewVote"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_new_vote"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary_bg"
            android:drawableStart="@drawable/ic_poll"
            android:drawablePadding="6dp" />

        <!-- Botão: Encerrar Votação (visível apenas durante votação ativa) -->
        <Button
            android:id="@+id/btnEndVote"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_end_vote"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary_bg"
            android:backgroundTint="@color/warning"
            android:drawableStart="@drawable/ic_close"
            android:drawablePadding="6dp"
            android:visibility="gone" />

        <!-- Botão: Histórico -->
        <Button
            android:id="@+id/btnHistory"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="Histórico"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_secondary_bg"
            android:drawableStart="@drawable/ic_history"
            android:drawablePadding="6dp" />

        <!-- Botão: Encerrar Chamada -->
        <Button
            android:id="@+id/btnLeaveCall"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Sair"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary_bg"
            android:backgroundTint="@color/error"
            android:drawableStart="@drawable/ic_call_end"
            android:drawablePadding="6dp" />

    </LinearLayout>

    <!-- ===================================================================
         CAMADA 3: Painel de Votação Ativa (overlay leve sobre o vídeo)
         Aparece na parte inferior/direita sem bloquear totalmente o vídeo
         =================================================================== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardVotingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="90dp"
        android:layout_marginHorizontal="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#EE16213E"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header do painel de votação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_poll"
                    android:contentDescription="Votação" />

                <TextView
                    android:id="@+id/tvVotingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/title_voting"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Timer da votação -->
                <LinearLayout
                    android:id="@+id/layoutTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_timer"
                        android:contentDescription="Timer" />

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="60s"
                        android:textColor="@color/warning"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Pergunta da votação -->
            <TextView
                android:id="@+id/tvVoteQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Qual plataforma usar para a próxima reunião?"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <!-- Lista de opções de votação (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVoteOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <!-- Indicador de voto já realizado -->
            <TextView
                android:id="@+id/tvVoteStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Você votou em: Discord"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===================================================================
         CAMADA 4: Painel de Histórico de Decisões
         Aparece como sheet lateral ao clicar em "Histórico"
         =================================================================== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHistoryPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="90dp"
        android:layout_marginHorizontal="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#EE0D0D1A"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header do histórico -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_history"
                    android:contentDescription="Histórico" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/title_vote_history"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCloseHistory"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Fechar" />

            </LinearLayout>

            <!-- Lista de decisões (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDecisionHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxHeight="300dp"
                android:nestedScrollingEnabled="true" />

            <!-- Mensagem quando não há histórico -->
            <TextView
                android:id="@+id/tvNoHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/label_no_history"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:visibility="visible" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===================================================================
         CAMADA 5: Indicador de sala no topo (nome da sala e participantes)
         =================================================================== -->
    <LinearLayout
        android:id="@+id/layoutRoomInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="#99000000">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_room"
            android:contentDescription="Sala" />

        <TextView
            android:id="@+id/tvRoomName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Sala: MinhaReunião"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
