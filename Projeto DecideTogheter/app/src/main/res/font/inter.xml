<?xml version="1.0" encoding="utf-8"?>
<!--
    Arquivo de família de fontes.
    Para usar a fonte Inter, baixe os arquivos .ttf do Google Fonts
    (https://fonts.google.com/specimen/Inter) e coloque-os nesta pasta:
    app/src/main/res/font/
    Arquivos esperados: inter_regular.ttf, inter_medium.ttf, inter_bold.ttf

    Enquanto os arquivos não estiverem presentes, o sistema usará a fonte padrão do Android.
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/inter_regular" />
    <font
        app:fontStyle="normal"
        app:fontWeight="500"
        app:font="@font/inter_medium" />
    <font
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/inter_bold" />
</font-family>
